<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.danfletcher.mac-inventory</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-m</string>
		<string>mac_inventory</string>
	</array>
	<key>WorkingDirectory</key>
	<string>REPLACE_WITH_ABSOLUTE_PATH_TO_mac-inventory-service</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/mac-inventory.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/mac-inventory.log</string>
</dict>
</plist>
